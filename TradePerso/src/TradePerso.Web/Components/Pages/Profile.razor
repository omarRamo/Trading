@page "/profile"
@attribute [Authorize]
@inject CurrentUserAccessor CurrentUser
@inject Application.Abstractions.Repositories.IUserSettingsRepository SettingsRepo
@inject Application.Abstractions.Repositories.INotificationPreferencesRepository PrefsRepo
@inject ISnackbar Snackbar

<PageTitle>Profile - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Profile</MudText>

@if (_email is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6">Account</MudText>
                <MudText Class="mt-2">Email: <strong>@_email</strong></MudText>
                <MudText>User ID: <code>@_userId</code></MudText>
                <form method="post" action="/auth/logout" class="mt-3">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Error" Variant="Variant.Outlined">Log out</MudButton>
                </form>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6">Notifications</MudText>
                @if (_prefs is not null)
                {
                    <MudSwitch T="bool" @bind-Value="_prefs.IsEnabled" Color="Color.Primary" Label="Email digest" Class="mt-2" />
                    <MudTextField @bind-Value="_prefs.Email" Label="Recipient" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                    <MudNumericField T="decimal" @bind-Value="_prefs.MinScore" Label="Minimum score" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                    <MudNumericField T="int" @bind-Value="_prefs.MaxItems" Label="Max items" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveAsync">Save</MudButton>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private string? _email;
    private string? _userId;
    private Domain.Entities.NotificationPreferences? _prefs;

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetUserIdAsync();
        _email = await CurrentUser.GetEmailAsync();
        if (_userId is null || _email is null) return;
        _prefs = await PrefsRepo.GetOrCreateAsync(_userId, _email);
    }

    private async Task SaveAsync()
    {
        if (_prefs is null) return;
        await PrefsRepo.UpsertAsync(_prefs);
        Snackbar.Add("Preferences saved", MudBlazor.Severity.Success);
    }
}
