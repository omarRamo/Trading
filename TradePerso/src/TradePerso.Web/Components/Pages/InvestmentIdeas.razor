@page "/ideas"
@attribute [Authorize]
@inject IRecommendationService Reco
@inject CurrentUserAccessor CurrentUser

<PageTitle>Investment ideas - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Investment ideas</MudText>

@if (_recos is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="2">
        @foreach (var r in _recos)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="pa-4 metric-card" Elevation="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">@r.Ticker</MudText>
                        <MudSpacer />
                        <MudChip T="string" Color="@ChipColor(r.Prudence)" Size="Size.Small">@r.Prudence</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mb-2">@r.Name</MudText>
                    <MudText Typo="Typo.body2"><strong>Score:</strong> @r.Score.ToString("0.0")</MudText>
                    <MudText Typo="Typo.body2"><strong>Price:</strong> @(r.Price?.ToString("N2") ?? "-")</MudText>
                    <MudText Typo="Typo.body2"><strong>1M / 3M / 1Y:</strong> @P(r.Perf1m) / @P(r.Perf3m) / @P(r.Perf1y)</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2">@r.Reasoning</MudText>
                    @if (r.AlreadyHeld)
                    {
                        <MudChip T="string" Size="Size.Small" Color="MudBlazor.Color.Info" Class="mt-2">Already in portfolio</MudChip>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IReadOnlyList<RecommendationDto>? _recos;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUser.GetUserIdAsync();
        if (userId is null) return;
        _recos = await Reco.GenerateAsync(userId);
    }

    private static MudBlazor.Color ChipColor(PrudenceLevel p) => p switch
    {
        PrudenceLevel.Interesting => MudBlazor.Color.Success,
        PrudenceLevel.Watch => MudBlazor.Color.Info,
        PrudenceLevel.Wait => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Error,
    };

    private static string P(decimal? v) => v.HasValue ? v.Value.ToString("P1") : "-";
}
