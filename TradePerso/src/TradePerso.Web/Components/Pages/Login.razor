@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in - TradePerso</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Class="pa-6" Elevation="3">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">TradePerso</MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="mb-6">Sign in to your account</MudText>

        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">Invalid email or password.</MudAlert>
        }

        <form method="post" action="/auth/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <MudTextField T="string" Label="Email" name="email" Required="true" InputType="InputType.Email"
                          Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" Label="Password" name="password" Required="true" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-4" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                Sign in
            </MudButton>
        </form>

        <MudDivider Class="my-4" />
        <MudText Align="Align.Center" Typo="Typo.body2">
            No account? <MudLink Href="/register">Create one</MudLink>
        </MudText>
        <MudText Align="Align.Center" Typo="Typo.caption" Class="mt-4">
            Demo: omar@tradeperso.local / admin
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; } = "/";
}
