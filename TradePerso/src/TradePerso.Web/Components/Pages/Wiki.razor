@page "/wiki"
@attribute [Authorize]

<PageTitle>Wiki - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Wiki</MudText>

<MudExpansionPanels Square="false" MultiExpansion="true">
    <MudExpansionPanel Text="Investment philosophy" Expanded="true">
        Long-term, diversified ETF core (around 70%), opportunistic stock picks (20%) and a cash cushion (10%).
        Re-balance to targets when drift exceeds 10%.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Scoring &amp; prudence levels">
        Scores combine trend (MA50/MA200), momentum (1M/3M/1Y) and RSI. Prudence:
        Interesting (75+), Watch (60-74), Wait (45-59), Avoid (&lt;45).
    </MudExpansionPanel>
    <MudExpansionPanel Text="Position sizing">
        Risk a fixed fraction of equity per trade (default 1%). Quantity = risk amount / |entry - stop|.
        Stay below the hard per-position cap.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Backtest strategies">
        DCA (constant monthly), 70/20/10 mix (lump + monthly buys), and lump sum baseline are compared
        with CAGR and max drawdown.
    </MudExpansionPanel>
    <MudExpansionPanel Text="Market data provider">
        Set <code>MarketData:Provider</code> in <code>appsettings.json</code> to <code>Yahoo</code> (default)
        or <code>Sample</code> for offline mode. Add a new provider by implementing
        <code>IMarketDataProvider</code> and registering it in DI.
    </MudExpansionPanel>
</MudExpansionPanels>

<MudAlert Severity="Severity.Info" Class="mt-4">
    This tool is for personal research only. It is not investment advice.
</MudAlert>
