@page "/portfolio"
@attribute [Authorize]
@inject IPortfolioService PortfolioSvc
@inject Application.Abstractions.Repositories.IPositionRepository Positions
@inject CurrentUserAccessor CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Portfolio - TradePerso</PageTitle>

<MudText Typo="Typo.h4" Class="page-title">Portfolio</MudText>

@if (_summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-2 metric-card">
                <MudTable Items="_summary.Positions" Dense="true" Striped="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Ticker</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Qty</MudTh>
                        <MudTh>Avg</MudTh>
                        <MudTh>Price</MudTh>
                        <MudTh>Value</MudTh>
                        <MudTh>P&L</MudTh>
                        <MudTh>Weight</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ticker"><strong>@context.Ticker</strong><br /><MudText Typo="Typo.caption">@context.Name</MudText></MudTd>
                        <MudTd DataLabel="Type">@context.AssetType</MudTd>
                        <MudTd DataLabel="Qty">@context.Quantity.ToString("0.####")</MudTd>
                        <MudTd DataLabel="Avg">@context.AvgBuyPrice.ToString("N2")</MudTd>
                        <MudTd DataLabel="Price">@(context.CurrentPrice?.ToString("N2") ?? "-")</MudTd>
                        <MudTd DataLabel="Value">@context.CurrentValue.ToString("N2")</MudTd>
                        <MudTd DataLabel="P&L">
                            <span class="@(context.Pnl >= 0 ? "pnl-positive" : "pnl-negative")">
                                @context.Pnl.ToString("N2") (@context.PnlPct.ToString("P1"))
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Weight">@context.Weight.ToString("P1")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteAsync(context.Ticker))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 metric-card">
                <MudText Typo="Typo.h6" Class="mb-2">Sector exposure</MudText>
                @foreach (var s in _summary.SectorExposure.OrderByDescending(kv => kv.Value))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudText>@s.Key</MudText>
                        <MudSpacer />
                        <MudText>@s.Value.ToString("P1")</MudText>
                    </MudStack>
                    <MudProgressLinear Value="@((double)(s.Value * 100m))" Color="Color.Primary" Class="mb-2" />
                }
            </MudPaper>

            <MudPaper Class="pa-4 metric-card mt-3">
                <MudText Typo="Typo.h6" Class="mb-2">Add / update position</MudText>
                <MudTextField @bind-Value="_form.Ticker" Label="Ticker" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_form.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudSelect T="AssetType" @bind-Value="_form.AssetType" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    @foreach (var t in Enum.GetValues<AssetType>())
                    {
                        <MudSelectItem Value="t">@t</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="decimal" @bind-Value="_form.Quantity" Label="Quantity" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudNumericField T="decimal" @bind-Value="_form.AvgBuyPrice" Label="Avg buy price" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudTextField @bind-Value="_form.Sector" Label="Sector" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3" OnClick="SaveAsync">Save</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private PortfolioSummaryDto? _summary;
    private string? _userId;
    private PositionForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetUserIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;
        _summary = await PortfolioSvc.ComputeSummaryAsync(_userId);
    }

    private async Task SaveAsync()
    {
        if (_userId is null || string.IsNullOrWhiteSpace(_form.Ticker)) return;
        await Positions.UpsertAsync(new Domain.Entities.Position
        {
            UserId = _userId,
            Ticker = _form.Ticker.Trim().ToUpperInvariant(),
            Name = _form.Name ?? _form.Ticker,
            AssetType = _form.AssetType,
            Quantity = _form.Quantity,
            AvgBuyPrice = _form.AvgBuyPrice,
            InvestedAmount = _form.Quantity * _form.AvgBuyPrice,
            Sector = _form.Sector ?? string.Empty,
        });
        Snackbar.Add("Position saved", MudBlazor.Severity.Success);
        _form = new PositionForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(string ticker)
    {
        if (_userId is null) return;
        await Positions.DeleteAsync(_userId, ticker);
        Snackbar.Add($"{ticker} removed");
        await LoadAsync();
    }

    private class PositionForm
    {
        public string? Ticker { get; set; }
        public string? Name { get; set; }
        public AssetType AssetType { get; set; } = AssetType.Stock;
        public decimal Quantity { get; set; }
        public decimal AvgBuyPrice { get; set; }
        public string? Sector { get; set; }
    }
}
