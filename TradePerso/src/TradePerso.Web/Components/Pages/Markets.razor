@page "/markets"
@attribute [Authorize]
@inject IMarketSyncService MarketSync
@inject Application.Abstractions.Repositories.IAssetRepository Assets
@inject CurrentUserAccessor CurrentUser
@inject ISnackbar Snackbar

<PageTitle>Markets - TradePerso</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Markets</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="SyncAsync">Sync</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-2 metric-card">
        <MudTable Items="_rows" Dense="true" Striped="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Ticker</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>1D</MudTh>
                <MudTh>1M</MudTh>
                <MudTh>3M</MudTh>
                <MudTh>1Y</MudTh>
                <MudTh>RSI</MudTh>
                <MudTh>MA50</MudTh>
                <MudTh>MA200</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ticker"><strong>@context.Ticker</strong><br /><MudText Typo="Typo.caption">@context.Name</MudText></MudTd>
                <MudTd DataLabel="Type">@context.AssetType</MudTd>
                <MudTd DataLabel="Price">@F(context.Quote?.Price)</MudTd>
                <MudTd DataLabel="1D">@P(context.Quote?.Change1d)</MudTd>
                <MudTd DataLabel="1M">@P(context.Quote?.Perf1m)</MudTd>
                <MudTd DataLabel="3M">@P(context.Quote?.Perf3m)</MudTd>
                <MudTd DataLabel="1Y">@P(context.Quote?.Perf1y)</MudTd>
                <MudTd DataLabel="RSI">@F(context.Quote?.Rsi14)</MudTd>
                <MudTd DataLabel="MA50">@F(context.Quote?.Ma50)</MudTd>
                <MudTd DataLabel="MA200">@F(context.Quote?.Ma200)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string? _userId;
    private List<Row> _rows = new();

    private record Row(string Ticker, string Name, AssetType AssetType, Domain.MarketData.MarketQuote? Quote);

    protected override async Task OnInitializedAsync()
    {
        _userId = await CurrentUser.GetUserIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_userId is null) return;
        _loading = true;
        var assets = await Assets.ListAsync(_userId, activeOnly: true);
        var tickers = assets.Select(a => a.Ticker).ToList();
        var quotes = await MarketSync.GetCachedQuotesAsync(_userId, tickers);
        _rows = assets.Select(a => new Row(a.Ticker, a.Name, a.AssetType,
            quotes.TryGetValue(a.Ticker, out var q) ? q : null)).ToList();
        _loading = false;
    }

    private async Task SyncAsync()
    {
        if (_userId is null) return;
        var n = await MarketSync.SyncAsync(_userId);
        Snackbar.Add($"Synced {n} tickers", MudBlazor.Severity.Success);
        await LoadAsync();
    }

    private static string F(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "-";
    private static string P(decimal? v) => v.HasValue ? v.Value.ToString("P1") : "-";
}
